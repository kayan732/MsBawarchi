# ───────────────────────────────────────────────────────────────────────
# Ms Bawarchi — environment variables
# ───────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values for your deployment.

# Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (transactional email) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ms Bawarchi <orders@msbawarchi.in>"

# MSG91 / Twilio (SMS OTP and order updates) ───────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloudinary (image and 3D asset CDN) ──────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (cart sessions, rate limits) ───────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Delivery partner (Porter / Dunzo) ────────────────────────────────────
PORTER_API_KEY=
PORTER_API_SECRET=

# Google Maps Places API ───────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin allowlist (comma-separated emails) ─────────────────────────────
ADMIN_EMAILS=
